---
import Header from '@/components/Header.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Compara precios de videojuegos en múltiples tiendas y encuentra las mejores ofertas" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script>
      // Detectar preferencia de color del sistema
      if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
    <style is:global>
      /* Altura estimada del header fijo; el propio Header la corrige por JS
         con su altura real (cambia entre móvil y escritorio). */
      :root {
        --header-height: 7.5rem;
      }

      @media (min-width: 768px) {
        :root {
          --header-height: 4rem;
        }
      }

      html {
        scroll-padding-top: var(--header-height);
      }
    </style>
  </head>
  <body class="bg-gray-900 text-gray-100 transition-colors duration-200">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-blue-600 focus:text-white focus:px-4 focus:py-2 focus:rounded">Ir al contenido principal</a>
    <Header />
    <main id="main-content" class="min-h-screen pt-[var(--header-height)]">
      <slot />
    </main>
    <footer class="bg-gray-800/80 backdrop-blur-sm border-t border-gray-700 py-8">
      <div class="container mx-auto px-4 text-center">
        <p class="mb-2">
          Datos proporcionados por <a href="https://www.cheapshark.com" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:text-blue-300">CheapShark</a>
        </p>
        <p class="text-gray-400 text-sm flex flex-wrap items-center justify-center gap-x-2 gap-y-1">
          <span>Hecho con 🩵 para la comunidad</span>
          <span aria-hidden="true" class="text-gray-600">·</span>
          <a
            href="https://github.com/KalZambrano/game-price-comparison"
            target="_blank"
            rel="noopener noreferrer"
            title="Ver el código en GitHub"
            class="inline-flex items-center gap-1.5 rounded text-gray-400 transition-colors duration-200 hover:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-400"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
              <path d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.78 1.05.78 2.12 0 1.53-.01 2.77-.01 3.15 0 .31.2.67.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z" />
            </svg>
            <span>GitHub</span>
          </a>
        </p>
      </div>
    </footer>

    <!-- Scroll to top button (visible after scrolling down) -->
    <div id="scroll-to-top-wrapper" class="fixed bottom-8 right-6 z-50">
      <button id="scrollToTop" type="button" class="group relative flex items-center justify-center w-12 h-12 bg-blue-600 text-white rounded-full shadow-lg hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-400 opacity-0 pointer-events-none transition-all duration-200 hover:scale-105" aria-label="Ir arriba">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
        </svg>
        <div class="absolute bottom-full mb-2 right-1/2 transform translate-x-1/2 opacity-0 group-hover:opacity-100 transition-opacity duration-150 pointer-events-none">
          <div class="bg-black text-white text-xs rounded px-2 py-1">Ir al inicio</div>
        </div>
      </button>
    </div>

    <script>
      (function () {
        const btn = document.getElementById('scrollToTop');
        if (!btn) return;
        const threshold = 200;

        const toggle = () => {
          if (window.scrollY > threshold) {
            btn.classList.remove('opacity-0', 'pointer-events-none');
          } else {
            btn.classList.add('opacity-0', 'pointer-events-none');
          }
        };

        window.addEventListener('scroll', toggle, { passive: true });
        document.addEventListener('DOMContentLoaded', toggle);

        btn.addEventListener('click', function () {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      })();
    </script>
  </body>
</html>
